# Studymate Environment Configuration
# Copy this file to .env and configure your settings

# ============================================================================
# Flask Configuration
# ============================================================================
SECRET_KEY=change-this-to-a-random-secret-key-in-production
DATABASE_URL=sqlite:///instance/contacts.db

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# Choose your AI provider: 'ollama' (local, free) or 'openai' (cloud, paid)
LLM_PROVIDER=ollama

# --- Ollama Configuration (Local AI - Recommended) ---
# These are the default values, uncomment to customize

# OLLAMA_CHAT_MODEL=mistral:7b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI Configuration (Cloud AI - Optional) ---
# Only needed if LLM_PROVIDER=openai

# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=4000
# OPENAI_TEMPERATURE=0.7

# ============================================================================
# Setup Instructions
# ============================================================================
#
# For Local AI (Ollama):
# 1. Install Ollama: curl https://ollama.ai/install.sh | sh
# 2. Start Ollama: ollama serve
# 3. Pull models:
#    ollama pull mistral:7b
#    ollama pull nomic-embed-text
# 4. Set LLM_PROVIDER=ollama (default)
#
# For Cloud AI (OpenAI):
# 1. Get API key from: https://platform.openai.com/api-keys
# 2. Set LLM_PROVIDER=openai
# 3. Set OPENAI_API_KEY=your-key
#
# ============================================================================
